[Unit]
Description=NetFix DPI Bypass Service
After=network-online.target
Wants=network-online.target
PartOf=netfix.target

[Service]
Type=simple
ExecStart=/usr/local/bin/netfixctl dpi-run
ExecStopPost=/usr/local/bin/netfixctl dpi-cleanup
Restart=on-failure
RestartSec=3
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID

[Install]
WantedBy=netfix.target
