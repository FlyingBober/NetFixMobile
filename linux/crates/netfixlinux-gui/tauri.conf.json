{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetFixLinux",
  "version": "0.1.0",
  "identifier": "dev.flyingbober.netfixlinux",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetFixLinux — (fork of NetFix Mobile by rupleide)",
        "width": 1120,
        "height": 700,
        "minWidth": 1020,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
